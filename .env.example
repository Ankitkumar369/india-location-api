# Database
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Redis Cache (Upstash) - Get free account at upstash.com
REDIS_URL="redis://default:xxxx@xxx.upstash.io:6379"

# JWT Authentication - Change this secret in production!
JWT_SECRET="change-this-to-a-secure-random-string-minimum-32-characters"
JWT_EXPIRES_IN="24h"

# Admin Account - Change these!
ADMIN_EMAIL="admin@villageapi.com"
ADMIN_PASSWORD="change-this-password"

# API Configuration
API_BASE_URL="https://your-api.vercel.app"
NODE_ENV="production"

# Rate Limiting (24 hours in milliseconds)
RATE_LIMIT_WINDOW_MS="86400000"